{
  "id": "split-both-forge",
  "title": "With the required reach lowered to 20, both sides of a 3 and 2 split keep forging, then one chain wins after the heal",
  "levels": ["L3", "L4"],
  "network": "devnet",
  "genesisSeed": "solar-devnet",
  "settleBlocks": 0,
  "env": {"CORE_P2P_MIN_NETWORK_REACH": "20"},
  "actors": {"prop-a": {"seed": 1}, "prop-b": {"seed": 2}, "prop-c": {"seed": 3}, "prop-d": {"seed": 4}, "payee": {"seed": 5}, "split-user": {"seed": 6}},
  "steps": [
    {"name": "fund the wallets", "at": {"height": 2}, "do": "submit", "node": 1, "via": "api",
     "txs": [
       {"ref": "fund", "type": "transfer", "from": "genesis", "fee": "10000000", "to": [["prop-a", "10000000000"], ["prop-b", "10000000000"], ["prop-c", "10000000000"], ["prop-d", "10000000000"], ["payee", "100000000"], ["split-user", "10000000000"]]}
     ]},
    {"name": "split the network", "at": {"height": 30}, "do": "partition", "groups": [[1, 2, 3], [4, 5]]},
    {"name": "let both sides run", "at": {"afterBlocks": 0}, "do": "wait", "blocks": 10},
    {"name": "heal", "at": {"afterBlocks": 0}, "do": "heal"},
    {"name": "every node on one chain", "at": {"afterBlocks": 0}, "check": {"invariant": ["singleTip"], "withinBlocks": 24}},
    {"name": "a transfer after the heal", "at": {"afterBlocks": 0}, "do": "submit", "node": 5, "via": "api", "check": {"accept": ["after-heal"]},
     "txs": [
       {"ref": "after-heal", "type": "transfer", "from": "split-user", "nonce": 1, "to": [["payee", "100000000"]]}
     ]},
    {"name": "forged after the heal", "at": {"afterBlocks": 1}, "check": {"forged": ["after-heal"], "invariant": ["singleTip"], "withinBlocks": 8}}
  ]
}
