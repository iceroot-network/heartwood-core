{
  "id": "missed-slots",
  "title": "A forger that stops leaves missed slots that every relay records alike",
  "levels": ["L3"],
  "network": "devnet",
  "genesisSeed": "solar-devnet",
  "settleBlocks": 0,
  "actors": {"voter-early": {"seed": 1}, "voter-restart": {"seed": 2}, "voter-round": {"seed": 3}, "extra-a": {"seed": 4}, "extra-b": {"seed": 5}, "extra-c": {"seed": 6}, "pool-a": {"seed": 7}, "pool-b": {"seed": 8}, "payee": {"seed": 9}, "miss-user": {"seed": 10}, "restart-user": {"seed": 11}, "split-user": {"seed": 12}},
  "steps": [
    {"name": "fund the wallets", "at": {"height": 2}, "do": "submit", "node": 1, "via": "api",
     "txs": [
       {"ref": "fund", "type": "transfer", "from": "genesis", "fee": "10000000", "to": [["voter-early", "10000000000"], ["voter-restart", "10000000000"], ["voter-round", "10000000000"], ["extra-a", "20000000000"], ["extra-b", "20000000000"], ["extra-c", "20000000000"], ["pool-a", "10000000000"], ["pool-b", "10000000000"], ["payee", "100000000"], ["miss-user", "10000000000"], ["restart-user", "10000000000"], ["split-user", "10000000000"]]}
     ]},
    {"name": "stop a forger", "at": {"height": 79}, "do": "stop", "node": 4, "role": "forger"},
    {"name": "a transfer while it is down", "at": {"afterBlocks": 2}, "do": "submit", "node": 1, "via": "api", "check": {"accept": ["while-down"]},
     "txs": [
       {"ref": "while-down", "type": "transfer", "from": "miss-user", "nonce": 1, "to": [["payee", "100000000"]]}
     ]},
    {"name": "start the forger again", "at": {"afterBlocks": 12}, "do": "start", "node": 4, "role": "forger"},
    {"name": "the slots were missed", "at": {"afterBlocks": 1}, "check": {"missed": {"node": 4, "atLeast": 1}, "forged": ["while-down"], "withinBlocks": 10}},
    {"name": "every relay records the same", "at": {"afterBlocks": 2}, "check": {"api": {"projection": "missed(2, 100)"}, "invariant": ["schedule"], "withinBlocks": 10}}
  ]
}
