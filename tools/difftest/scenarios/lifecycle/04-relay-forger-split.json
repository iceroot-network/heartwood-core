{
  "id": "relay-forger-split",
  "title": "A forger restarts without its relay, a relay without its forger, and a forger with failover keeps forging while its relay is down",
  "levels": ["L3"],
  "network": "devnet",
  "genesisSeed": "solar-devnet",
  "settleBlocks": 0,
  "actors": {"voter-early": {"seed": 1}, "voter-restart": {"seed": 2}, "voter-round": {"seed": 3}, "extra-a": {"seed": 4}, "extra-b": {"seed": 5}, "extra-c": {"seed": 6}, "pool-a": {"seed": 7}, "pool-b": {"seed": 8}, "payee": {"seed": 9}, "miss-user": {"seed": 10}, "restart-user": {"seed": 11}, "split-user": {"seed": 12}},
  "steps": [
    {"name": "fund the wallets", "at": {"height": 2}, "do": "submit", "node": 1, "via": "api",
     "txs": [
       {"ref": "fund", "type": "transfer", "from": "genesis", "fee": "10000000", "to": [["voter-early", "10000000000"], ["voter-restart", "10000000000"], ["voter-round", "10000000000"], ["extra-a", "20000000000"], ["extra-b", "20000000000"], ["extra-c", "20000000000"], ["pool-a", "10000000000"], ["pool-b", "10000000000"], ["payee", "100000000"], ["miss-user", "10000000000"], ["restart-user", "10000000000"], ["split-user", "10000000000"]]}
     ]},
    {"name": "stop a forger alone", "at": {"height": 111}, "do": "stop", "node": 2, "role": "forger"},
    {"name": "its relay keeps up", "at": {"afterBlocks": 2}, "check": {"invariant": ["singleTip"], "withinBlocks": 6}},
    {"name": "start the forger again", "at": {"afterBlocks": 0}, "do": "start", "node": 2, "role": "forger"},
    {"name": "stop a relay alone", "at": {"afterBlocks": 1}, "do": "stop", "node": 3, "role": "relay"},
    {"name": "start the relay again", "at": {"afterBlocks": 3}, "do": "start", "node": 3, "role": "relay"},
    {"name": "one tip again", "at": {"afterBlocks": 0}, "check": {"invariant": ["singleTip"], "withinBlocks": 10}},
    {"name": "stop the relay of the forger with failover", "at": {"afterBlocks": 1}, "do": "stop", "node": 1, "role": "relay"},
    {"name": "start it again", "at": {"afterBlocks": 3}, "do": "start", "node": 1, "role": "relay"},
    {"name": "one tip after the failover", "at": {"afterBlocks": 0}, "check": {"invariant": ["singleTip"], "withinBlocks": 10}},
    {"name": "restart a forger", "at": {"afterBlocks": 1}, "do": "restart", "node": 4, "role": "forger"},
    {"name": "a transfer after the restarts", "at": {"afterBlocks": 1}, "do": "submit", "node": 3, "via": "api", "check": {"accept": ["after-split"]},
     "txs": [
       {"ref": "after-split", "type": "transfer", "from": "split-user", "nonce": 1, "to": [["payee", "100000000"]]}
     ]},
    {"name": "forged", "at": {"afterBlocks": 0}, "check": {"forged": ["after-split"], "invariant": ["singleTip"], "withinBlocks": 8}}
  ]
}
