{
  "id": "partition-heal",
  "title": "A 3 and 2 split: the side with 33 delegates forges, the side with 20 stops below the required reach, and all converge on the majority's chain after the heal",
  "levels": ["L3", "L4"],
  "network": "devnet",
  "genesisSeed": "solar-devnet",
  "settleBlocks": 0,
  "actors": {"prop-a": {"seed": 1}, "prop-b": {"seed": 2}, "prop-c": {"seed": 3}, "prop-d": {"seed": 4}, "payee": {"seed": 5}, "split-user": {"seed": 6}, "late-user": {"seed": 7}},
  "steps": [
    {"name": "fund the wallets", "at": {"height": 2}, "do": "submit", "node": 1, "via": "api",
     "txs": [
       {"ref": "fund", "type": "transfer", "from": "genesis", "fee": "10000000", "to": [["prop-a", "10000000000"], ["prop-b", "10000000000"], ["prop-c", "10000000000"], ["prop-d", "10000000000"], ["payee", "100000000"], ["split-user", "10000000000"], ["late-user", "10000000000"]]}
     ]},
    {"name": "split the network", "at": {"height": 66}, "do": "partition", "groups": [[1, 2, 3], [4, 5]]},
    {"name": "a transfer on the majority side", "at": {"afterBlocks": 0}, "do": "submit", "node": 1, "via": "api", "check": {"accept": ["majority-side"]},
     "txs": [
       {"ref": "majority-side", "type": "transfer", "from": "split-user", "nonce": 1, "to": [["payee", "100000000"]]}
     ]},
    {"name": "the same nonce on the minority side", "at": {"afterBlocks": 0}, "do": "submit", "node": 4, "via": "api", "check": {"accept": ["minority-side"]},
     "txs": [
       {"ref": "minority-side", "type": "transfer", "from": "split-user", "nonce": 1, "to": [["payee", "200000000"]]}
     ]},
    {"name": "let both sides run", "at": {"afterBlocks": 0}, "do": "wait", "blocks": 10},
    {"name": "heal", "at": {"afterBlocks": 0}, "do": "heal"},
    {"name": "every node on one chain", "at": {"afterBlocks": 0}, "check": {"invariant": ["singleTip"], "withinBlocks": 24}},
    {"name": "a transfer after the heal", "at": {"afterBlocks": 0}, "do": "submit", "node": 5, "via": "api", "check": {"accept": ["after-heal"]},
     "txs": [
       {"ref": "after-heal", "type": "transfer", "from": "split-user", "nonce": 2, "to": [["payee", "300000000"]]}
     ]},
    {"name": "forged after the heal, on the majority's chain", "at": {"afterBlocks": 1}, "check": {"forged": ["majority-side", "after-heal"], "absent": ["minority-side"], "invariant": ["singleTip"], "withinBlocks": 8}}
  ]
}
