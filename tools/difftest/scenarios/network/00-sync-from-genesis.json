{
  "id": "sync-from-genesis",
  "title": "A node that starts late syncs the whole chain from genesis from the others and reaches their tip",
  "levels": ["L3", "L4"],
  "network": "devnet",
  "genesisSeed": "solar-devnet",
  "settleBlocks": 0,
  "actors": {"prop-a": {"seed": 1}, "prop-b": {"seed": 2}, "prop-c": {"seed": 3}, "prop-d": {"seed": 4}, "payee": {"seed": 5}, "split-user": {"seed": 6}},
  "steps": [
    {"name": "fund the wallets", "at": {"height": 2}, "do": "submit", "node": 1, "via": "api",
     "txs": [
       {"ref": "fund", "type": "transfer", "from": "genesis", "fee": "10000000", "to": [["prop-a", "10000000000"], ["prop-b", "10000000000"], ["prop-c", "10000000000"], ["prop-d", "10000000000"], ["payee", "100000000"], ["split-user", "10000000000"]]}
     ]},
    {"name": "the fifth node starts from nothing", "at": {"height": 16}, "do": "start", "node": 5},
    {"name": "it reaches the tip", "at": {"afterBlocks": 1}, "check": {"invariant": ["singleTip"], "withinBlocks": 12}},
    {"name": "a transfer from it", "at": {"afterBlocks": 0}, "do": "submit", "node": 5, "via": "api", "check": {"accept": ["from-late-node"]},
     "txs": [
       {"ref": "from-late-node", "type": "transfer", "from": "prop-a", "nonce": 1, "to": [["payee", "100000000"]]}
     ]},
    {"name": "the others forge it", "at": {"afterBlocks": 1}, "check": {"forged": ["from-late-node"], "invariant": ["singleTip"], "withinBlocks": 6}}
  ]
}
