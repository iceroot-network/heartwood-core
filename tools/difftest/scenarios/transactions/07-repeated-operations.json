{
  "id": "repeated-operations",
  "title": "A vote, a registration and a resignation repeated within one block and across blocks are refused the second time",
  "levels": ["L2", "L3"],
  "network": "devnet",
  "genesisSeed": "solar-devnet",
  "settleBlocks": 0,
  "actors": {"hop-a": {"seed": 1}, "hop-b": {"seed": 2}, "hop-c": {"seed": 3}, "spender": {"seed": 4}, "payee": {"seed": 5}, "nonce-user": {"seed": 6}, "gap-user": {"seed": 7}, "poor": {"seed": 8}, "exact-a": {"seed": 10}, "exact-b": {"seed": 11}, "voter-a": {"seed": 12}, "voter-b": {"seed": 13}, "registrant-a": {"seed": 14}, "registrant-b": {"seed": 15}, "registrant-c": {"seed": 16}, "resigner": {"seed": 17}, "sig-owner": {"seed": 18}, "second-key": {"seed": 19}, "burner": {"seed": 20}, "bulk-1": {"seed": 21}, "bulk-2": {"seed": 22}, "bulk-3": {"seed": 23}},
  "steps": [
    {"name": "fund the wallets", "at": {"height": 2}, "do": "submit", "node": 1, "via": "api",
     "txs": [
       {"ref": "fund", "type": "transfer", "from": "genesis", "fee": "10000000", "to": [["hop-a", "50000000000"], ["hop-b", "300000000"], ["hop-c", "300000000"], ["spender", "100000000000"], ["payee", "100000000"], ["nonce-user", "100000000000"], ["gap-user", "100000000000"], ["poor", "1000"], ["exact-a", "10000000000"], ["exact-b", "10000000000"], ["voter-a", "10000000000"], ["voter-b", "10000000000"], ["registrant-a", "20000000000"], ["registrant-b", "20000000000"], ["registrant-c", "20000000000"], ["resigner", "20000000000"], ["sig-owner", "10000000000"], ["second-key", "100000000"], ["burner", "10000000000"], ["bulk-1", "100000000000"], ["bulk-2", "100000000000"], ["bulk-3", "100000000000"]]}
     ]},
    {"name": "votes twice in one block", "at": {"height": 80}, "do": "submit", "node": 1, "via": "api", "check": {"accept": ["vote-first"], "invalid": ["vote-again-same-block"], "codes": {"vote-again-same-block": "ERR_APPLY"}},
     "txs": [
       {"ref": "vote-first", "type": "vote", "from": "voter-a", "nonce": 1, "asset": {"votes": [["genesis_20", 100]]}},
       {"ref": "vote-again-same-block", "type": "vote", "from": "voter-a", "nonce": 2, "asset": {"votes": [["genesis_20", 100]]}}
     ]},
    {"name": "votes again after the block", "at": {"afterBlocks": 2}, "do": "submit", "node": 1, "via": "api", "check": {"accept": ["vote-other-later"], "invalid": ["vote-again-later"], "codes": {"vote-again-later": "ERR_APPLY"}},
     "txs": [
       {"ref": "vote-again-later", "type": "vote", "from": "voter-a", "nonce": 2, "fee": "20000000", "asset": {"votes": [["genesis_20", 100]]}},
       {"ref": "vote-other-later", "type": "vote", "from": "voter-a", "nonce": 2, "asset": {"votes": [["genesis_21", 100]]}}
     ]},
    {"name": "registers twice in one block", "at": {"afterBlocks": 1}, "do": "submit", "node": 1, "via": "api", "check": {"accept": ["register-first"], "invalid": ["register-again-same-block", "register-name-same-block"], "codes": {"register-again-same-block": "ERR_APPLY", "register-name-same-block": "ERR_APPLY"}},
     "txs": [
       {"ref": "register-first", "type": "delegateRegistration", "from": "registrant-a", "nonce": 1, "asset": {"username": "regone"}},
       {"ref": "register-again-same-block", "type": "delegateRegistration", "from": "registrant-a", "nonce": 2, "asset": {"username": "regtwo"}},
       {"ref": "register-name-same-block", "type": "delegateRegistration", "from": "registrant-b", "nonce": 1, "asset": {"username": "regone"}}
     ]},
    {"name": "registers again after the block", "at": {"afterBlocks": 2}, "do": "submit", "node": 1, "via": "api", "check": {"invalid": ["register-again-later", "register-name-later"], "codes": {"register-again-later": "ERR_APPLY", "register-name-later": "ERR_APPLY"}},
     "txs": [
       {"ref": "register-again-later", "type": "delegateRegistration", "from": "registrant-a", "nonce": 2, "asset": {"username": "regthree"}},
       {"ref": "register-name-later", "type": "delegateRegistration", "from": "registrant-c", "nonce": 1, "asset": {"username": "regone"}}
     ]},
    {"name": "a registered delegate resigns twice in one block", "at": {"afterBlocks": 1}, "do": "submit", "node": 1, "via": "api", "check": {"accept": ["resigner-registers"]},
     "txs": [
       {"ref": "resigner-registers", "type": "delegateRegistration", "from": "resigner", "nonce": 1, "asset": {"username": "resigntwice"}}
     ]},
    {"name": "resignation", "at": {"afterBlocks": 2}, "do": "submit", "node": 1, "via": "api", "check": {"accept": ["resign-first"], "invalid": ["resign-again-same-block"], "codes": {"resign-again-same-block": "ERR_APPLY"}},
     "txs": [
       {"ref": "resign-first", "type": "delegateResignation", "from": "resigner", "nonce": 2, "asset": {"resignationType": 0}},
       {"ref": "resign-again-same-block", "type": "delegateResignation", "from": "resigner", "nonce": 3, "asset": {"resignationType": 0}}
     ]},
    {"name": "resigns again after the block", "at": {"afterBlocks": 2}, "do": "submit", "node": 1, "via": "api", "check": {"invalid": ["resign-again-later"], "codes": {"resign-again-later": "ERR_APPLY"}},
     "txs": [
       {"ref": "resign-again-later", "type": "delegateResignation", "from": "resigner", "nonce": 3, "fee": "1", "asset": {"resignationType": 0}}
     ]},
    {"name": "what was kept", "at": {"afterBlocks": 2}, "check": {"forged": ["vote-first", "vote-other-later", "register-first", "resigner-registers", "resign-first"], "absent": ["vote-again-same-block", "vote-again-later", "register-again-same-block", "register-name-same-block", "register-again-later", "register-name-later", "resign-again-same-block", "resign-again-later"], "digest": true}}
  ]
}
