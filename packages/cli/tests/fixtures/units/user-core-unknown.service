[Unit]
Description=Heartwood core of node1 on devnet
StartLimitIntervalSec=10
StartLimitBurst=5

[Service]
Type=exec
ExecStart=/usr/local/bin/heartwood core run --token=node1 --network=devnet
Restart=always
KillSignal=SIGINT
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=yes
Environment=CORE_SERVICE_MANAGER=systemd

[Install]
WantedBy=default.target
