[Unit]
Description=Heartwood forger of node1 on devnet
StartLimitIntervalSec=10
StartLimitBurst=5
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/heartwood forger run --token=node1 --network=devnet
Restart=always
KillSignal=SIGINT
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=yes
Environment=CORE_SERVICE_MANAGER=systemd
Environment=CORE_SERVICE_UNIT=%n
Environment=CORE_PATH_CONFIG=/srv/node/.config/node1-core/devnet
Environment=CORE_PATH_DATA=/srv/node/.local/share/node1-core/devnet
Environment=CORE_PATH_CACHE=/srv/node/.cache/node1-core/devnet
Environment=CORE_PATH_LOG=/srv/node/.local/state/node1-core/devnet
Environment=CORE_PATH_TEMP=/tmp/node/node1-core/devnet
User=node
SystemCallArchitectures=native
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictSUIDSGID=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
